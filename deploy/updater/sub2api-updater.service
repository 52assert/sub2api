[Unit]
Description=Sub2API container update service
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sub2api-updater/agent.py --config /etc/sub2api-updater/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/sub2api-deploy /var/lib/sub2api-updater

[Install]
WantedBy=multi-user.target
